# Standalone native implementation candidate. No Android Binder integration.
# Capability is established by BSS/peer evidence, not by these build options.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL_TINY=y
CONFIG_CTRL_IFACE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211BE=y
CONFIG_IEEE80211W=y
CONFIG_SAE=y
CONFIG_SAE_PK=y
CONFIG_OWE=y
CONFIG_ACS=y
CONFIG_WNM_AP=y
CONFIG_MBO=y
CONFIG_TLS=openssl
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_PKCS12=y
CONFIG_DEBUG_FILE=y
